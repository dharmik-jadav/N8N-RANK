NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayPal listing fee (developer.paypal.com > Apps & Credentials). Use sandbox keys until you go live.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Server only. Never expose this to the browser.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENV=sandbox

# Public site URL (used for share images and links). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
